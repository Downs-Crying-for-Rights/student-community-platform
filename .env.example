# ===========================================
# 学生交流社区平台 - 环境变量配置
# ===========================================
# 复制此文件为 .env 并填写实际值
# cp .env.example .env

# ---------- 数据库 ----------
# PostgreSQL 连接字符串
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/student_community?schema=public"

# ---------- Redis ----------
# Redis 连接地址
REDIS_URL="redis://localhost:6379"

# ---------- NextAuth ----------
# NextAuth 密钥（用于加密会话，请使用随机字符串）
# 生成方式: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-change-me"

# NextAuth 回调 URL（必填，否则登录后跳回 localhost）
# 本地开发: http://localhost:3000
# 生产部署: 填入你的实际访问域名，如 https://student.example.com
NEXTAUTH_URL="http://localhost:3000"

# ---------- SMTP 邮件服务 ----------
# 用于发送魔法链接认证邮件
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-email-password"
SMTP_FROM="noreply@example.com"
SMTP_TLS_SERVERNAME=""

# ---------- 应用配置 ----------
# 应用运行端口
PORT=3000

# 节点环境
NODE_ENV="development"

# ---------- QQ OAuth 登录 ----------
# QQ 互联应用 APP ID 和 APP Secret
# 申请地址: https://connect.qq.com/
QQ_APP_ID="your-qq-app-id"
QQ_APP_SECRET="your-qq-app-secret"

# ---------- QQ 机器人 / OneBot ----------
# 默认关闭；仅在 NapCat、专用机器人 QQ 和内部 worker 均准备完成后开启
QQ_BOT_ENABLED=false
QQ_BOT_EXPECTED_SELF_ID=""
# 以下三个密钥均使用 32 字节随机值，可用 openssl rand -base64 32 生成
QQ_IDENTITY_ENCRYPTION_KEY=""
QQ_IDENTITY_HMAC_KEY=""
QQ_GRANT_HMAC_KEY=""
QQ_IDENTITY_KEY_VERSION=1
IDENTITY_VERIFICATION_ENCRYPTION_KEY=""
# Rotate by retaining old versioned keys, for example IDENTITY_VERIFICATION_ENCRYPTION_KEY_V1.
IDENTITY_VERIFICATION_PREVIOUS_ENCRYPTION_KEY=""
IDENTITY_VERIFICATION_HMAC_KEY=""
IDENTITY_VERIFICATION_KEY_VERSION=1
QQ_GRANT_TTL_SECONDS=900
INTERNAL_API_TOKEN=""
# 个人 QQ Worker / NapCat（启用 QQ_BOT_ENABLED 时必填）
ONEBOT_WS_URL=""
ONEBOT_ACCESS_TOKEN=""
ONEBOT_ALLOWED_USER_IDS=""
NAPCAT_WEBUI_BASE_URL=""
NAPCAT_WEBUI_TOKEN=""

# ---------- QQ 官方机器人 ----------
# 腾讯 QQ 开放平台 AppID 和 ClientSecret；凭据仅配置在服务器环境中
QQ_OFFICIAL_BOT_ENABLED=false
QQ_OFFICIAL_BOT_APP_ID=""
QQ_OFFICIAL_BOT_CLIENT_SECRET=""
# 官方机器人使用 Gateway WebSocket 主动连接，无需配置公网回调地址。

# ---------- SMS 短信服务 ----------
# 测试模式：true 时使用固定验证码 888888，不发送真实短信
SMS_TEST_MODE=true
# 生产环境设置为 false，并配置阿里云标准凭据链：
# 推荐为仅授予 dypns:SendSmsVerifyCode 的 RAM 用户配置以下变量，切勿使用主账号 AccessKey
ALIBABA_CLOUD_ACCESS_KEY_ID=""
ALIBABA_CLOUD_ACCESS_KEY_SECRET=""
# 号码认证服务赠送签名和模板；模板参数必须包含 ${code} 和 ${min}
ALIYUN_SMS_SIGN_NAME=""
ALIYUN_SMS_TEMPLATE_LOGIN=""
ALIYUN_SMS_TEMPLATE_CHANGE_PHONE=""
ALIYUN_SMS_TEMPLATE_RESET_PASSWORD=""
ALIYUN_SMS_TEMPLATE_BIND_NEW_PHONE=""
ALIYUN_SMS_TEMPLATE_VERIFY_BOUND_PHONE=""
# 中国站号码认证服务地址和超时
ALIYUN_SMS_ENDPOINT="dypnsapi.aliyuncs.com"
ALIYUN_SMS_CONNECT_TIMEOUT_MS=5000
ALIYUN_SMS_READ_TIMEOUT_MS=5000

# ---------- 阿里云 OSS 图片存储 ----------
# OSS 区域（如 oss-cn-hangzhou）
OSS_REGION="oss-cn-hangzhou"
# OSS Bucket 名称
OSS_BUCKET="your-bucket-name"
# OSS AccessKey ID
OSS_ACCESS_KEY_ID="your-access-key-id"
# OSS AccessKey Secret
OSS_ACCESS_KEY_SECRET="your-access-key-secret"
# OSS Endpoint（可选，默认根据 region 自动生成）
OSS_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"
# CDN 域名（可选，默认使用 OSS 直连域名）
OSS_CDN_DOMAIN="https://your-bucket-name.oss-cn-hangzhou.aliyuncs.com"

# ---------- DeepSeek AI 审核辅助 ----------
# 默认关闭；配置 API Key 并完成影子运行验证后再启用
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_DEFAULT_MODEL="deepseek-v4-flash"
DEEPSEEK_COMPLEX_MODEL="deepseek-v4-flash"
DEEPSEEK_TIMEOUT_MS=25000
DEEPSEEK_MAX_INPUT_CHARS=12000
DEEPSEEK_MAX_OUTPUT_TOKENS=1800
# 后台保存 AI API Key 时使用；生产应配置独立 32 字节随机密钥
SYSTEM_SECRET_ENCRYPTION_KEY=""

# ---------- 聚合登录 ----------
# 聚合登录平台 OAuth2 接口（https://u.daib.cn/doc.php）
# 支持 QQ、微信、支付宝、微博、GitHub 等 17 种第三方登录
OAUTH_AGGREGATOR_APPID="2701"
OAUTH_AGGREGATOR_APPKEY="660490dbca0478fb77256503f89aee76"
